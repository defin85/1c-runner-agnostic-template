////////////////////////////////////////////////////////////////////////////////
// Шаблон объекта внешней обработки с синхронным и фоновым запуском.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

Функция СведенияОВнешнейОбработке() Экспорт

	РегистрационныеДанные = Новый Структура;
	РегистрационныеДанные.Вставить("Наименование", "TemplateSyncAsyncProcessor");
	РегистрационныеДанные.Вставить("БезопасныйРежим", Ложь);
	РегистрационныеДанные.Вставить("Версия", "1.0");
	РегистрационныеДанные.Вставить("ВерсияБСП", "1.2.1.4");
	РегистрационныеДанные.Вставить("Вид", "ДополнительнаяОбработка");
	РегистрационныеДанные.Вставить("Информация", "Шаблон синхронной и фоновой внешней обработки");

	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Идентификатор");
	Команды.Колонки.Добавить("Представление");
	Команды.Колонки.Добавить("Модификатор");
	Команды.Колонки.Добавить("ПоказыватьОповещение");
	Команды.Колонки.Добавить("Использование");

	Команда = Команды.Добавить();
	Команда.Идентификатор = "ВыполнитьСценарий";
	Команда.Представление = "Выполнить сценарий";
	Команда.ПоказыватьОповещение = Истина;
	Команда.Использование = "ОткрытиеФормы";

	РегистрационныеДанные.Вставить("Команды", Команды);

	Возврат РегистрационныеДанные;

КонецФункции

Процедура ВыполнитьСценарий(СтруктураПараметров, АдресРезультата) Экспорт

	Результат = ВыполнитьСценарийВнутренний(СтруктураПараметров);
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);

КонецПроцедуры

Функция ВыполнитьСценарийСинхронно(СтруктураПараметров) Экспорт

	Возврат ВыполнитьСценарийВнутренний(СтруктураПараметров);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВыполнитьСценарийВнутренний(СтруктураПараметров)

	Результат = СоздатьПустойРезультат();

	Попытка
		ПроверитьПараметрыСценария(СтруктураПараметров);
		ОтправитьПрогресс(10, "Параметры проверены.");

		Результат.Успех = Истина;
		Результат.Сообщение = "Сценарий выполнен.";
		Результат.Данные = СтруктураПараметров;
		ОтправитьПрогресс(100, "Сценарий завершен.");
	Исключение
		Результат.СообщениеОбОшибке = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

Функция СоздатьПустойРезультат()

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("СообщениеОбОшибке", "");
	Результат.Вставить("Данные", Неопределено);

	Возврат Результат;

КонецФункции

Процедура ПроверитьПараметрыСценария(СтруктураПараметров)

	Если ТипЗнч(СтруктураПараметров) <> Тип("Структура") Тогда
		ВызватьИсключение "Параметры сценария должны быть структурой.";
	КонецЕсли;

КонецПроцедуры

Процедура ОтправитьПрогресс(Процент, Текст)

	Попытка
		ДлительныеОперации.СообщитьПрогресс(Процент, Текст);
	Исключение
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
