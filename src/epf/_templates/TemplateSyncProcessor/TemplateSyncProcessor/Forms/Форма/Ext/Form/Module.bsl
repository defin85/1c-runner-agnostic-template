////////////////////////////////////////////////////////////////////////////////
// Форма шаблона внешней обработки с синхронным запуском.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	КомментарийЗапуска = "";
	СводкаВыполнения = "";

	Обработка = РеквизитФормыВЗначение("Объект");
	СведенияОбработки = Обработка.СведенияОВнешнейОбработке();
	Заголовок = СведенияОбработки.Информация + " (версия " + СведенияОбработки.Версия + ")";

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКоманд

&НаКлиенте
Процедура ВыполнитьСценарий(Команда)

	ВыполнитьСценарийНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СерверныеКоманды

&НаСервере
Процедура ВыполнитьСценарийНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Результат = Обработка.ВыполнитьСценарийСинхронно(ПолучитьПараметрыСценария());
	ПрименитьРезультатСценария(Результат);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьПараметрыСценария()

	ПараметрыСценария = Новый Структура;
	ПараметрыСценария.Вставить("КомментарийЗапуска", КомментарийЗапуска);

	Возврат ПараметрыСценария;

КонецФункции

&НаСервере
Процедура ПрименитьРезультатСценария(Результат)

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Результат.Свойство("СообщениеОбОшибке") И НЕ ПустаяСтрока(Результат.СообщениеОбОшибке) Тогда
		СводкаВыполнения = Результат.СообщениеОбОшибке;
	ИначеЕсли Результат.Свойство("Сообщение") Тогда
		СводкаВыполнения = Результат.Сообщение;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
