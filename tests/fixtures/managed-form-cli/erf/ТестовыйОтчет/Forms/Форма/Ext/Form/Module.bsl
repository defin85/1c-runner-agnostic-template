#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура OldCommand(Команда) Экспорт
	Число = Число + 1;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает фактическую серверную привязку поля для smoke-проверки.
// Параметры:
//  ИмяПоля - Строка - имя проверяемого поля.
// Возвращаемое значение:
//  Строка - путь к реквизиту формы.
&НаКлиенте
Функция ПутьПоля(ИмяПоля) Экспорт
	Возврат ПутьПоляНаСервере(ИмяПоля);
КонецФункции

&НаСервере
Функция ПутьПоляНаСервере(Знач ИмяПоля)
	Возврат Элементы[ИмяПоля].ПутьКДанным;
КонецФункции

#КонецОбласти
