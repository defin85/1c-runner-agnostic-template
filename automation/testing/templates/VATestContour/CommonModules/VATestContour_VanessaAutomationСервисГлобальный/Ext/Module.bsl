#Если Не ВебКлиент Тогда

#Область ПрограммныйИнтерфейс

// Подготавливает форму Vanessa Automation Single к повторным запускам в текущей клиентской сессии.
//
// Параметры:
//  ПутьКSingle - Строка - локальный путь к vanessa-automation-single.epf.
//  ДополнительныеНастройки - Структура - пользовательские настройки запуска поверх значений по умолчанию.
Процедура ПодготовитьVanessaAutomation(ПутьКSingle, ДополнительныеНастройки = Неопределено, НастройкиVanessaСервиса = Неопределено) Экспорт

	ФормаVanessaAutomation = ПолучитьФормуVanessaAutomation(ПутьКSingle, НастройкиVanessaСервиса);
	НастройкиЗапуска = НастройкиЗапускаVanessaПоУмолчанию();
	ДополнитьНастройкиЗапускаVanessa(НастройкиЗапуска, ДополнительныеНастройки);
	ФормаVanessaAutomation.УстановитьНастройкиПриЗапускеБезОткрытияФормы(НастройкиЗапуска);
	ЗаполнитьКлиентовТестированияVanessa(ФормаVanessaAutomation, НастройкиЗапуска);

КонецПроцедуры

// Запускает сценарии Vanessa Automation по feature-файлу без открытия основной формы.
//
// Параметры:
//  ПутьКSingle - Строка - локальный путь к vanessa-automation-single.epf.
//  ПутьКФичаФайлу - Строка - локальный путь к feature-файлу.
//  ДополнительныеНастройки - Структура - пользовательские настройки запуска поверх значений по умолчанию.
Процедура ЗапуститьСценарииVanessaИзФайла(ПутьКSingle, ПутьКФичаФайлу, ДополнительныеНастройки = Неопределено, ВидимыйМенеджер = Ложь) Экспорт

	Если ПустаяСтрока(СокрЛП(ПутьКФичаФайлу)) Тогда
		ВызватьИсключение "Не указан путь к feature-файлу Vanessa Automation.";
	КонецЕсли;

	ФормаVanessaAutomation = ПолучитьФормуVanessaAutomation(ПутьКSingle);
	ФормаVanessaAutomation.УстановитьФичаФайл(ПутьКФичаФайлу);
	ПрименитьНастройкиЗапускаVanessa(ФормаVanessaAutomation, ДополнительныеНастройки);
	Если ВидимыйМенеджер Тогда
		ФормаVanessaAutomation.Открыть();
		ПрименитьНастройкиЗапускаVanessa(ФормаVanessaAutomation, ДополнительныеНастройки);
	КонецЕсли;
	ФормаVanessaAutomation.ВыполнитьСценарииБезОткрытияФормы();

КонецПроцедуры

// Запускает сценарии Vanessa Automation по переданному тексту feature-файла.
//
// Параметры:
//  ПутьКSingle - Строка - локальный путь к vanessa-automation-single.epf.
//  ТекстФичаФайла - Строка - текст сценария Gherkin.
//  ДополнительныеНастройки - Структура - пользовательские настройки запуска поверх значений по умолчанию.
Процедура ЗапуститьСценарииVanessaИзТекста(ПутьКSingle, ТекстФичаФайла, ДополнительныеНастройки = Неопределено) Экспорт

	Если ПустаяСтрока(СокрЛП(ТекстФичаФайла)) Тогда
		ВызватьИсключение "Не передан текст feature-файла Vanessa Automation.";
	КонецЕсли;

	ФормаVanessaAutomation = ПолучитьФормуVanessaAutomation(ПутьКSingle);
	ФормаVanessaAutomation.УстановитьТекстФичаФайла(ТекстФичаФайла);
	ПрименитьНастройкиЗапускаVanessa(ФормаVanessaAutomation, ДополнительныеНастройки);
	ФормаVanessaAutomation.ВыполнитьСценарииБезОткрытияФормы();

КонецПроцедуры

// Инициализирует локальный reusable Vanessa-сервис в manager-сеансе по параметру командной строки.
Процедура VATestContour_ИнициализироватьVanessaСервис() Экспорт

	ПутьКФайлуНастроек = ПутьКФайлуНастроекVanessaСервиса();
	Если ПустаяСтрока(ПутьКФайлуНастроек) Тогда
		Возврат;
	КонецЕсли;

	НастройкиVanessaСервиса = ПрочитатьНастройкиVanessaСервиса(ПутьКФайлуНастроек);
	ОчиститьСлужебныеФайлыVanessaСервиса(НастройкиVanessaСервиса);
	ЗаписатьТекстВФайлVanessaСервиса(НастройкиVanessaСервиса.ResponseFile, "INIT_ENTER");

	Попытка
		ИнициализироватьVanessaСервис(НастройкиVanessaСервиса);
		ПодключитьОбработчикОжидания("ОбработатьКомандыVanessaСервиса", 1, Ложь);
	Исключение
		ЗафиксироватьОшибкуVanessaСервиса(
			НастройкиVanessaСервиса,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
			Истина);
	КонецПопытки;

КонецПроцедуры

// Выполняет инициализацию и обслуживает очередь команд reusable Vanessa-сервиса.
Процедура ОбработатьКомандыVanessaСервиса() Экспорт

	ПутьКФайлуНастроек = ПутьКФайлуНастроекVanessaСервиса();
	Если ПустаяСтрока(ПутьКФайлуНастроек) Тогда
		Возврат;
	КонецЕсли;

	НастройкиVanessaСервиса = ПрочитатьНастройкиVanessaСервиса(ПутьКФайлуНастроек);

	Попытка
		ОбработатьКомандуVanessaСервиса(НастройкиVanessaСервиса);
	Исключение
		ЗафиксироватьОшибкуVanessaСервиса(
			НастройкиVanessaСервиса,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьФормуVanessaAutomation(ПутьКSingle, НастройкиVanessaСервиса = Неопределено)

	ЗаписатьСтатусПодготовкиVanessaСервиса(НастройкиVanessaСервиса, "INIT_CHECK_SINGLE_PATH");
	ПроверитьПутьКSingle(ПутьКSingle);

	ФормаVanessaAutomation = VATestContour_ПолучитьФормуVanessaAutomation();
	Если ФормаVanessaAutomation <> Неопределено Тогда
		ЗаписатьСтатусПодготовкиVanessaСервиса(НастройкиVanessaСервиса, "INIT_FORM_REUSED");
		Возврат ФормаVanessaAutomation;
	КонецЕсли;

	ПомещаемыеФайлы = Новый Массив;
	ПомещаемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(ПутьКSingle, ""));

	ПомещенныеФайлы = Новый Массив;
	ЗаписатьСтатусПодготовкиVanessaСервиса(НастройкиVanessaСервиса, "INIT_UPLOAD_SINGLE");
	Если Не ПоместитьФайлы(ПомещаемыеФайлы, ПомещенныеФайлы, , Ложь) Тогда
		ВызватьИсключение "Не удалось поместить Vanessa Automation Single с локального компьютера в приложение.";
	КонецЕсли;

	Если ПомещенныеФайлы.Количество() <> 1 Тогда
		ВызватьИсключение "Не удалось получить адрес временного хранилища для Vanessa Automation Single.";
	КонецЕсли;

	ЗаписатьСтатусПодготовкиVanessaСервиса(НастройкиVanessaСервиса, "INIT_CONNECT_SINGLE");
	ИмяВнешнейОбработки = VATestContour_VanessaAutomationСервисВызовСервера.ПодключитьVanessaAutomationSingleНаСервере(ПомещенныеФайлы[0].Хранение);
	ЗаписатьСтатусПодготовкиVanessaСервиса(НастройкиVanessaСервиса, "INIT_GET_FORM");
	ФормаVanessaAutomation = ПолучитьФормуВнешнейОбработкиVanessaAutomation(ИмяВнешнейОбработки);
	VATestContour_СохранитьФормуVanessaAutomation(ФормаVanessaAutomation);
	ЗаписатьСтатусПодготовкиVanessaСервиса(НастройкиVanessaСервиса, "INIT_FORM_READY");

	Возврат ФормаVanessaAutomation;

КонецФункции

Процедура VATestContour_СохранитьФормуVanessaAutomation(ФормаVanessaAutomation) Экспорт

КонецПроцедуры

Функция VATestContour_ПолучитьФормуVanessaAutomation() Экспорт
	Возврат Неопределено;
КонецФункции

Функция ПутьКФайлуНастроекVanessaСервиса()

	КлючПараметра = "VATestContourVanessaServiceConfig=";
	НачалоПараметра = СтрНайти(ПараметрЗапуска, КлючПараметра);
	Если НачалоПараметра = 0 Тогда
		Возврат "";
	КонецЕсли;

	НачалоЗначения = НачалоПараметра + СтрДлина(КлючПараметра);
	КонецЗначения = СтрНайти(ПараметрЗапуска, ";", , НачалоЗначения);
	Если КонецЗначения = 0 Тогда
		Возврат Сред(ПараметрЗапуска, НачалоЗначения);
	КонецЕсли;

	Возврат Сред(ПараметрЗапуска, НачалоЗначения, КонецЗначения - НачалоЗначения);

КонецФункции

Функция ПрочитатьНастройкиVanessaСервиса(ПутьКФайлуНастроек)

	Если ПустаяСтрока(ПутьКФайлуНастроек) Тогда
		ВызватьИсключение "Не указан путь к настройкам Vanessa-сервиса.";
	КонецЕсли;

	ФайлНастроек = Новый Файл(ПутьКФайлуНастроек);
	Если Не ФайлНастроек.Существует() Тогда
		ВызватьИсключение "Файл настроек Vanessa-сервиса не найден: " + ПутьКФайлуНастроек;
	КонецЕсли;

	ТекстНастроек = Новый ТекстовыйДокумент;
	ТекстНастроек.Прочитать(ПутьКФайлуНастроек, КодировкаТекста.UTF8);

	Настройки = Новый Структура;
	Для НомерСтроки = 1 По ТекстНастроек.КоличествоСтрок() Цикл
		СтрокаНастроек = СокрЛП(ТекстНастроек.ПолучитьСтроку(НомерСтроки));
		Если ПустаяСтрока(СтрокаНастроек) Тогда
			Продолжить;
		КонецЕсли;

		ПозицияРазделителя = СтрНайти(СтрокаНастроек, "=");
		Если ПозицияРазделителя = 0 Тогда
			Продолжить;
		КонецЕсли;

		ИмяНастройки = Лев(СтрокаНастроек, ПозицияРазделителя - 1);
		ЗначениеНастройки = Сред(СтрокаНастроек, ПозицияРазделителя + 1);
		Настройки.Вставить(ИмяНастройки, ЗначениеНастройки);
	КонецЦикла;

	ПроверитьНаличиеНастройкиVanessaСервиса(Настройки, "SinglePath");
	ПроверитьНаличиеНастройкиVanessaСервиса(Настройки, "WarmupFeaturePath");
	ПроверитьНаличиеНастройкиVanessaСервиса(Настройки, "FeatureRuntimePath");
	ПроверитьНаличиеНастройкиVanessaСервиса(Настройки, "BuildStatusPath");
	ПроверитьНаличиеНастройкиVanessaСервиса(Настройки, "RunCompletePath");
	ПроверитьНаличиеНастройкиVanessaСервиса(Настройки, "VanessaOnlinePath");
	ПроверитьНаличиеНастройкиVanessaСервиса(Настройки, "ScreensDir");
	ПроверитьНаличиеНастройкиVanessaСервиса(Настройки, "WorkspaceRoot");
	ПроверитьНаличиеНастройкиVanessaСервиса(Настройки, "LibraryPaths");
	ПроверитьНаличиеНастройкиVanessaСервиса(Настройки, "ReadyFile");
	ПроверитьНаличиеНастройкиVanessaСервиса(Настройки, "RequestFile");
	ПроверитьНаличиеНастройкиVanessaСервиса(Настройки, "ResponseFile");
	ПроверитьНаличиеНастройкиVanessaСервиса(Настройки, "ErrorFile");
	ПроверитьНаличиеНастройкиVanessaСервиса(Настройки, "TestClientConnectionString");
	ПроверитьНаличиеНастройкиVanessaСервиса(Настройки, "TestClientPort");
	ПроверитьНаличиеНастройкиVanessaСервиса(Настройки, "TestClientExtraArgs");

	Возврат Настройки;

КонецФункции

Процедура ПрименитьНастройкиЗапускаVanessa(ФормаVanessaAutomation, ДополнительныеНастройки)

	НастройкиЗапуска = НастройкиЗапускаVanessaПоУмолчанию();
	ДополнитьНастройкиЗапускаVanessa(НастройкиЗапуска, ДополнительныеНастройки);
	ФормаVanessaAutomation.УстановитьНастройкиПриЗапускеБезОткрытияФормы(НастройкиЗапуска);
	ЗаполнитьКлиентовТестированияVanessa(ФормаVanessaAutomation, НастройкиЗапуска);

КонецПроцедуры

Функция ПолучитьФормуВнешнейОбработкиVanessaAutomation(ИмяВнешнейОбработки)

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИнициализироватьVanessaEditor", Ложь);

	Попытка
		Возврат ПолучитьФорму("ВнешняяОбработка." + ИмяВнешнейОбработки + ".Форма.УправляемаяФорма", ПараметрыФормы);
	Исключение
		Возврат ПолучитьФорму("ВнешняяОбработка." + ИмяВнешнейОбработки + ".Форма", ПараметрыФормы);
	КонецПопытки;

КонецФункции

Процедура ДополнитьНастройкиЗапускаVanessa(НастройкиЗапуска, ДополнительныеНастройки)

	Если ДополнительныеНастройки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(ДополнительныеНастройки) <> Тип("Структура") Тогда
		ВызватьИсключение "Дополнительные настройки запуска Vanessa Automation должны передаваться структурой.";
	КонецЕсли;

	Для Каждого ЭлементНастроек Из ДополнительныеНастройки Цикл
		НастройкиЗапуска.Вставить(ЭлементНастроек.Ключ, ЭлементНастроек.Значение);
	КонецЦикла;

КонецПроцедуры

Функция НастройкиЗапускаVanessaПоУмолчанию()

	НастройкиЗапуска = Новый Структура;
	НастройкиЗапуска.Вставить("ИспользоватьКомпонентуVanessaExt", Истина);
	НастройкиЗапуска.Вставить("ЗакрытьTestClientПослеЗапускаСценариев", Ложь);
	НастройкиЗапуска.Вставить("ЗавершитьРаботуСистемы", Ложь);

	Возврат НастройкиЗапуска;

КонецФункции

Процедура ПроверитьПутьКSingle(ПутьКSingle)

	Если ПустаяСтрока(СокрЛП(ПутьКSingle)) Тогда
		ВызватьИсключение "Не указан путь к Vanessa Automation Single.";
	КонецЕсли;

	Если НРег(Прав(ПутьКSingle, 4)) <> ".epf" Тогда
		ВызватьИсключение "Vanessa Automation Single должен передаваться как путь к epf-файлу.";
	КонецЕсли;

	ФайлSingle = Новый Файл(ПутьКSingle);
	Если Не ФайлSingle.Существует() Тогда
		ВызватьИсключение "Файл Vanessa Automation Single не найден: " + ПутьКSingle;
	КонецЕсли;

	КонецПроцедуры

Процедура ЗаписатьСтатусПодготовкиVanessaСервиса(НастройкиVanessaСервиса, Статус)

	Если НастройкиVanessaСервиса = Неопределено
		Или ТипЗнч(НастройкиVanessaСервиса) <> Тип("Структура")
		Или Не НастройкиVanessaСервиса.Свойство("ResponseFile") Тогда
		Возврат;
	КонецЕсли;

	ЗаписатьТекстВФайлVanessaСервиса(НастройкиVanessaСервиса.ResponseFile, Статус);

КонецПроцедуры

	Процедура ИнициализироватьVanessaСервис(НастройкиVanessaСервиса)

		ДополнительныеНастройки = НастройкиЗапускаVanessaСервиса(НастройкиVanessaСервиса);
		ПодготовитьАртефактыVanessaСценария(НастройкиVanessaСервиса);
		ЗаписатьТекстВФайлVanessaСервиса(НастройкиVanessaСервиса.ResponseFile, "INIT_PREPARE_SINGLE");

		ПодготовитьVanessaAutomation(
			НастройкиVanessaСервиса.SinglePath,
			ДополнительныеНастройки,
			НастройкиVanessaСервиса);
	ЗаписатьТекстВФайлVanessaСервиса(НастройкиVanessaСервиса.ResponseFile, "INIT_RUN_WARMUP");

	ЗапуститьСценарииVanessaИзФайла(
		НастройкиVanessaСервиса.SinglePath,
		НастройкиVanessaСервиса.WarmupFeaturePath,
		ДополнительныеНастройки,
		ВидимыйМенеджерVanessaСервиса(НастройкиVanessaСервиса));
	ЗаписатьТекстВФайлVanessaСервиса(НастройкиVanessaСервиса.ResponseFile, "INIT_WAIT_STATUS");

КонецПроцедуры

Процедура ОбработатьКомандуVanessaСервиса(НастройкиVanessaСервиса)

	Команда = ВРег(СокрЛП(ПрочитатьТекстИзФайлаVanessaСервиса(НастройкиVanessaСервиса.RequestFile)));

	Если Команда = "STOP" Тогда
		ЗаписатьТекстВФайлVanessaСервиса(НастройкиVanessaСервиса.RequestFile, "");
		ЗаписатьТекстВФайлVanessaСервиса(НастройкиVanessaСервиса.ResponseFile, "STOPPING");
		ОтключитьОбработчикОжидания("ОбработатьКомандыVanessaСервиса");
		ЗаписатьТекстВФайлVanessaСервиса(НастройкиVanessaСервиса.ResponseFile, "STOPPED");
		ЗавершитьРаботуСистемы(Ложь);
		Возврат;
	КонецЕсли;

	Если СокрЛП(ПрочитатьТекстИзФайлаVanessaСервиса(НастройкиVanessaСервиса.ResponseFile)) = "INIT_WAIT_STATUS" Тогда
		ОбработатьЗавершениеИнициализацииVanessaСервиса(НастройкиVanessaСервиса);
		Возврат;
	КонецЕсли;

	Если СокрЛП(ПрочитатьТекстИзФайлаVanessaСервиса(НастройкиVanessaСервиса.ReadyFile)) = "RUNNING" Тогда
		ОбработатьЗавершениеСценарияVanessaСервиса(НастройкиVanessaСервиса);
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(Команда) Тогда
		Возврат;
	КонецЕсли;

	ЗаписатьТекстВФайлVanessaСервиса(НастройкиVanessaСервиса.RequestFile, "");
	ЗаписатьТекстВФайлVanessaСервиса(НастройкиVanessaСервиса.ResponseFile, "");
	ЗаписатьТекстВФайлVanessaСервиса(НастройкиVanessaСервиса.ErrorFile, "");

	Если Команда = "RUN" Тогда
		ВыполнитьСценарийVanessaИзОчереди(НастройкиVanessaСервиса);
	Иначе
		ЗафиксироватьОшибкуVanessaСервиса(
			НастройкиVanessaСервиса,
			"Неизвестная команда Vanessa-сервиса: " + Команда);
	КонецЕсли;

КонецПроцедуры

Процедура ВыполнитьСценарийVanessaИзОчереди(НастройкиVanessaСервиса)

	ПодготовитьАртефактыVanessaСценария(НастройкиVanessaСервиса);
	ЗаписатьТекстВФайлVanessaСервиса(НастройкиVanessaСервиса.ReadyFile, "RUNNING");
	ЗапуститьСценарииVanessaИзФайла(
		НастройкиVanessaСервиса.SinglePath,
		НастройкиVanessaСервиса.FeatureRuntimePath,
		НастройкиЗапускаVanessaСервиса(НастройкиVanessaСервиса),
		ВидимыйМенеджерVanessaСервиса(НастройкиVanessaСервиса));

КонецПроцедуры

Процедура ОбработатьЗавершениеИнициализацииVanessaСервиса(НастройкиVanessaСервиса)

	КодСтатуса = КодСтатусаВыполненияVanessa(НастройкиVanessaСервиса);
	Если ПустаяСтрока(КодСтатуса) Тогда
		Возврат;
	КонецЕсли;

	Если КодСтатуса = "0" Тогда
		ЗаписатьТекстВФайлVanessaСервиса(НастройкиVanessaСервиса.ReadyFile, "READY");
		ЗаписатьТекстВФайлVanessaСервиса(НастройкиVanessaСервиса.ResponseFile, "");
	Иначе
		ЗафиксироватьОшибкуVanessaСервиса(
			НастройкиVanessaСервиса,
			"Warmup scenario finished with BuildStatus=" + КодСтатуса,
			Истина);
	КонецЕсли;

КонецПроцедуры

Процедура ОбработатьЗавершениеСценарияVanessaСервиса(НастройкиVanessaСервиса)

	КодСтатуса = КодСтатусаВыполненияVanessa(НастройкиVanessaСервиса);
	Если ЗначениеЗаполнено(КодСтатуса) И КодСтатуса <> "0" Тогда
		ЗафиксироватьОшибкуVanessaСервиса(
			НастройкиVanessaСервиса,
			"Scenario finished with BuildStatus=" + КодСтатуса);
		Возврат;
	КонецЕсли;

	Если СокрЛП(ПрочитатьТекстИзФайлаVanessaСервиса(НастройкиVanessaСервиса.RunCompletePath)) <> "DONE" Тогда
		Возврат;
	КонецЕсли;

	ЗаписатьТекстВФайлVanessaСервиса(НастройкиVanessaСервиса.ReadyFile, "READY");
	ЗаписатьТекстВФайлVanessaСервиса(НастройкиVanessaСервиса.ResponseFile, "OK");

КонецПроцедуры

Функция НастройкиЗапускаVanessaСервиса(НастройкиVanessaСервиса)

	ДополнительныеНастройки = Новый Структура;
	ДополнительныеНастройки.Вставить("ИспользоватьКомпонентуVanessaExt", Истина);
	ДополнительныеНастройки.Вставить("ЗакрытьTestClientПослеЗапускаСценариев", Истина);
	ДополнительныеНастройки.Вставить("ЗавершитьРаботуСистемы", Ложь);
	ДополнительныеНастройки.Вставить("ДелатьЛогВыполненияСценариевВТекстовыйФайл", Истина);
	ДополнительныеНастройки.Вставить("ВыводитьВЛогВыполнениеШагов", Истина);
	ДополнительныеНастройки.Вставить("ВыгружатьСтатусВыполненияСценариевВФайл", Истина);
	ДополнительныеНастройки.Вставить("ПутьКФайлуДляВыгрузкиСтатусаВыполненияСценариев", НастройкиVanessaСервиса.BuildStatusPath);
	ДополнительныеНастройки.Вставить("ИмяФайлаЛогВыполненияСценариев", НастройкиVanessaСервиса.VanessaOnlinePath);
	ДополнительныеНастройки.Вставить("КаталогПроекта", НастройкиVanessaСервиса.WorkspaceRoot);
	ДополнительныеНастройки.Вставить("КаталогВыгрузкиСкриншотов", НастройкиVanessaСервиса.ScreensDir);
	ДополнительныеНастройки.Вставить("КаталогиБиблиотек", КаталогиБиблиотекVanessaСервиса(НастройкиVanessaСервиса));
	Если НастройкиVanessaСервиса.Свойство("TestClientPortRange")
		И Не ПустаяСтрока(СокрЛП(НастройкиVanessaСервиса.TestClientPortRange)) Тогда
		ДополнительныеНастройки.Вставить("ДиапазонПортовTestclient", НастройкиVanessaСервиса.TestClientPortRange);
	КонецЕсли;

	НастройкиКлиентаТестирования = Новый Структура;
	НастройкиКлиентаТестирования.Вставить("ТаймаутЗапуска1С", 180);
	НастройкиКлиентаТестирования.Вставить("ЗакрытьTestClientПослеЗапускаСценариев", Истина);
	НастройкиКлиентаТестирования.Вставить("ДанныеКлиентовТестирования", КлиентыТестированияVanessaСервиса(НастройкиVanessaСервиса));
	ДополнительныеНастройки.Вставить("КлиентТестирования", НастройкиКлиентаТестирования);

	Возврат ДополнительныеНастройки;

КонецФункции

Функция ВидимыйМенеджерVanessaСервиса(НастройкиVanessaСервиса)

	Если Не НастройкиVanessaСервиса.Свойство("VisibleManager") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат НРег(СокрЛП(НастройкиVanessaСервиса.VisibleManager)) = "true";

КонецФункции

	Функция КаталогиБиблиотекVanessaСервиса(НастройкиVanessaСервиса)

		Результат = Новый Массив;

		Для Каждого Каталог Из СтрРазделить(НастройкиVanessaСервиса.LibraryPaths, ":") Цикл
			Если Не ПустаяСтрока(СокрЛП(Каталог)) Тогда
				Результат.Добавить(Каталог);
			КонецЕсли;
		КонецЦикла;

		Возврат Результат;

	КонецФункции

	Функция КлиентыТестированияVanessaСервиса(НастройкиVanessaСервиса)

		Клиент = Новый Структура;
		Клиент.Вставить("Имя", "Этот клиент");
		Клиент.Вставить("Синоним", "");
		Клиент.Вставить("ПутьКИнфобазе", НастройкиVanessaСервиса.TestClientConnectionString);
		Клиент.Вставить("ПортЗапускаТестКлиента", Число(НастройкиVanessaСервиса.TestClientPort));
		Клиент.Вставить("ДопПараметры", НастройкиVanessaСервиса.TestClientExtraArgs);
		Клиент.Вставить("ТипКлиента", "Тонкий");
		Клиент.Вставить("ИмяКомпьютера", "localhost");
		Клиент.Вставить("АктивизироватьСтроку", Истина);
		Клиент.Вставить("ЭтотКлиент", Истина);
		Клиент.Вставить("Подключен", Ложь);
		Клиент.Вставить("PIDКлиентаТестирования", 0);

		Результат = Новый Массив;
		Результат.Добавить(Клиент);
		Возврат Результат;

	КонецФункции

	Процедура ЗаполнитьКлиентовТестированияVanessa(ФормаVanessaAutomation, НастройкиЗапуска)

		НастройкиКлиентаТестирования = Неопределено;
		Если Не НастройкиЗапуска.Свойство("КлиентТестирования", НастройкиКлиентаТестирования) Тогда
			Возврат;
		КонецЕсли;

		ДанныеКлиентовТестирования = Неопределено;
		Если Не НастройкиКлиентаТестирования.Свойство("ДанныеКлиентовТестирования", ДанныеКлиентовТестирования) Тогда
			Возврат;
		КонецЕсли;

		Если ДанныеКлиентовТестирования.Количество() > 0 Тогда
			ФормаVanessaAutomation.ДанныеКлиентовТестирования.Очистить();
		КонецЕсли;

		Для Каждого Клиент Из ДанныеКлиентовТестирования Цикл
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Имя", Клиент.Имя);
			НайденныеСтроки = ФормаVanessaAutomation.ДанныеКлиентовТестирования.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество() > 0 Тогда
				СтрокаКлиента = НайденныеСтроки[0];
			Иначе
				СтрокаКлиента = ФормаVanessaAutomation.ДанныеКлиентовТестирования.Добавить();
				СтрокаКлиента.Имя = Клиент.Имя;
			КонецЕсли;

			СтрокаКлиента.ПутьКИнфобазе = Клиент.ПутьКИнфобазе;
			СтрокаКлиента.ДопПараметры = Клиент.ДопПараметры;
			СтрокаКлиента.ТипКлиента = Клиент.ТипКлиента;
			СтрокаКлиента.ИмяКомпьютера = Клиент.ИмяКомпьютера;
			СтрокаКлиента.ПортЗапускаТестКлиента = Клиент.ПортЗапускаТестКлиента;
			Если Клиент.Свойство("ЭтотКлиент") Тогда
				Если Клиент.ЭтотКлиент Тогда
					Для Каждого СтрокаДанныхКлиента Из ФормаVanessaAutomation.ДанныеКлиентовТестирования Цикл
						СтрокаДанныхКлиента.ЭтотКлиент = Ложь;
					КонецЦикла;
				КонецЕсли;
				СтрокаКлиента.ЭтотКлиент = Клиент.ЭтотКлиент;
			КонецЕсли;
			Если Клиент.Свойство("Подключен") Тогда
				СтрокаКлиента.Подключен = Клиент.Подключен;
			КонецЕсли;
			Если Клиент.Свойство("PIDКлиентаТестирования") Тогда
				СтрокаКлиента.PIDКлиентаТестирования = Клиент.PIDКлиентаТестирования;
			КонецЕсли;
			Если Клиент.Свойство("Синоним") Тогда
				СтрокаКлиента.Синоним = Клиент.Синоним;
			КонецЕсли;

			Если Не Клиент.Свойство("АктивизироватьСтроку") Или Клиент.АктивизироватьСтроку Тогда
				ФормаVanessaAutomation.Элементы.ДанныеКлиентовТестирования.ТекущаяСтрока = СтрокаКлиента.ПолучитьИдентификатор();
			КонецЕсли;
		КонецЦикла;

	КонецПроцедуры

	Функция КодСтатусаВыполненияVanessa(НастройкиVanessaСервиса)

	Возврат СокрЛП(ПрочитатьТекстИзФайлаVanessaСервиса(НастройкиVanessaСервиса.BuildStatusPath));

КонецФункции

Процедура ПодготовитьАртефактыVanessaСценария(НастройкиVanessaСервиса)

	ЗаписатьТекстВФайлVanessaСервиса(НастройкиVanessaСервиса.BuildStatusPath, "");
	ЗаписатьТекстВФайлVanessaСервиса(НастройкиVanessaСервиса.VanessaOnlinePath, "");
	ЗаписатьТекстВФайлVanessaСервиса(НастройкиVanessaСервиса.RunCompletePath, "");

КонецПроцедуры

Процедура ОчиститьСлужебныеФайлыVanessaСервиса(НастройкиVanessaСервиса)

	ЗаписатьТекстВФайлVanessaСервиса(НастройкиVanessaСервиса.ReadyFile, "");
	ЗаписатьТекстВФайлVanessaСервиса(НастройкиVanessaСервиса.RequestFile, "");
	ЗаписатьТекстВФайлVanessaСервиса(НастройкиVanessaСервиса.ResponseFile, "");
	ЗаписатьТекстВФайлVanessaСервиса(НастройкиVanessaСервиса.ErrorFile, "");

КонецПроцедуры

Процедура ЗафиксироватьОшибкуVanessaСервиса(НастройкиVanessaСервиса, ТекстОшибки, ФатальнаяОшибка = Ложь)

	ТекущийЭтап = СокрЛП(ПрочитатьТекстИзФайлаVanessaСервиса(НастройкиVanessaСервиса.ResponseFile));
	Если ЗначениеЗаполнено(ТекущийЭтап) Тогда
		ТекстОшибки = "[" + ТекущийЭтап + "] " + ТекстОшибки;
	КонецЕсли;

	ЗаписатьТекстВФайлVanessaСервиса(НастройкиVanessaСервиса.ErrorFile, ТекстОшибки);
	ЗаписатьТекстВФайлVanessaСервиса(НастройкиVanessaСервиса.ResponseFile, "ERROR");

	Если ФатальнаяОшибка Тогда
		ОтключитьОбработчикОжидания("ОбработатьКомандыVanessaСервиса");
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьНаличиеНастройкиVanessaСервиса(Настройки, ИмяНастройки)

	Если Не Настройки.Свойство(ИмяНастройки) Тогда
		ВызватьИсключение "В настройках Vanessa-сервиса не найдено значение " + ИмяНастройки + ".";
	КонецЕсли;

КонецПроцедуры

Функция ПрочитатьТекстИзФайлаVanessaСервиса(ПутьКФайлу)

	ФайлДанных = Новый Файл(ПутьКФайлу);
	Если Не ФайлДанных.Существует() Тогда
		Возврат "";
	КонецЕсли;

	Текст = Новый ТекстовыйДокумент;
	Текст.Прочитать(ПутьКФайлу, КодировкаТекста.UTF8);

	Строки = Новый Массив;
	Для НомерСтроки = 1 По Текст.КоличествоСтрок() Цикл
		Строки.Добавить(Текст.ПолучитьСтроку(НомерСтроки));
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Процедура ЗаписатьТекстВФайлVanessaСервиса(ПутьКФайлу, ТекстДляЗаписи)

	ТекстовыйФайл = Новый ТекстовыйДокумент;
	Если Не ПустаяСтрока(ТекстДляЗаписи) Тогда
		Для Каждого СтрокаТекста Из СтрРазделить(ТекстДляЗаписи, Символы.ПС) Цикл
			ТекстовыйФайл.ДобавитьСтроку(СтрокаТекста);
		КонецЦикла;
	КонецЕсли;

	ТекстовыйФайл.Записать(ПутьКФайлу, КодировкаТекста.UTF8);

КонецПроцедуры

#КонецОбласти

#КонецЕсли
