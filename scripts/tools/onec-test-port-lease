#!/usr/bin/env python3
import argparse
import json
import os
import socket
import time
from pathlib import Path


def state_root() -> Path:
    root = os.environ.get("ONEC_TEST_PORT_LEASE_ROOT")
    if root:
        return Path(root)
    project = os.environ.get("ONEC_PROJECT_ROOT", os.getcwd())
    return Path(project) / ".artifacts" / "port-leases"


def state_path() -> Path:
    root = state_root()
    root.mkdir(parents=True, exist_ok=True)
    return root / "leases.json"


def load_state() -> dict:
    path = state_path()
    if not path.exists():
        return {"leases": []}
    return json.loads(path.read_text(encoding="utf-8"))


def save_state(state: dict) -> None:
    state_path().write_text(json.dumps(state, ensure_ascii=False, indent=2), encoding="utf-8")


def parse_range(value: str) -> tuple[int, int]:
    start, end = value.split("-", 1)
    return int(start), int(end)


def port_is_free(port: int) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            sock.bind(("127.0.0.1", port))
        except OSError:
            return False
    return True


def lease(args: argparse.Namespace) -> int:
    state = load_state()
    start, end = parse_range(args.range)
    used = {port for item in state["leases"] for port in item.get("ports", [])}

    for port in range(start, end + 1):
        ports = list(range(port, port + args.size))
        if ports[-1] > end:
            break
        if any(candidate in used or not port_is_free(candidate) for candidate in ports):
            continue

        item = {
            "lease_id": f"lease-{int(time.time() * 1000000)}-{port}",
            "service_id": args.service_id,
            "repo": args.repo,
            "role": args.role,
            "range": args.range,
            "start": port,
            "ports": ports,
            "pid": args.pid,
        }
        state["leases"].append(item)
        save_state(state)
        print(json.dumps(item, ensure_ascii=False))
        return 0

    raise SystemExit("no free ports")


def release(args: argparse.Namespace) -> int:
    state = load_state()
    leases = state["leases"]
    if args.lease_id:
        leases = [item for item in leases if item.get("lease_id") != args.lease_id]
    else:
        leases = [
            item for item in leases
            if not (item.get("service_id") == args.service_id and item.get("role") == args.role)
        ]
    state["leases"] = leases
    save_state(state)
    return 0


def status(_args: argparse.Namespace) -> int:
    print(json.dumps(load_state(), ensure_ascii=False))
    return 0


def main() -> int:
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="command", required=True)

    lease_parser = sub.add_parser("lease")
    lease_parser.add_argument("--service-id", required=True)
    lease_parser.add_argument("--repo", required=True)
    lease_parser.add_argument("--role", required=True)
    lease_parser.add_argument("--range", required=True)
    lease_parser.add_argument("--size", type=int, default=1)
    lease_parser.add_argument("--pid", type=int)
    lease_parser.set_defaults(func=lease)

    release_parser = sub.add_parser("release")
    release_parser.add_argument("--lease-id")
    release_parser.add_argument("--service-id")
    release_parser.add_argument("--role")
    release_parser.set_defaults(func=release)

    status_parser = sub.add_parser("status")
    status_parser.set_defaults(func=status)

    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
